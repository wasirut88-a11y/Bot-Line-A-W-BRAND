# LINE Developers console → channel → Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers console → channel → Basic settings tab
LINE_CHANNEL_SECRET=

# Google AI Studio → API keys
GEMINI_API_KEY=

# Google Sheet → File → Share → Publish to web → this sheet → Comma-separated values (.csv)
SHEET_CSV_URL=

# Optional. LINE group the bot pushes to when a message is routed to a human.
# Without it, handoff still replies to the customer — it just cannot notify anyone.
ADMIN_GROUP_ID=
